{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.prism/adapters/lib/prism-hook\" --harness claude-code --gate push",
            "timeout": 3600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.prism/adapters/lib/prism-hook\" --harness claude-code --gate ktlint",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.prism/adapters/lib/prism-hook\" --harness claude-code --gate stop",
            "timeout": 1800
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.prism/adapters/lib/prism-hook\" --harness claude-code --gate subagent",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
