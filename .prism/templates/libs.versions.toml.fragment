# Version catalog entries the PRISM payload requires.
#
# GENERATED by tools/catalog-fragment.py from what the payload actually
# references. Do not edit by hand -- run the generator.
#
# Setup MERGES these into the consumer's gradle/libs.versions.toml, adding only
# what is absent and never overwriting an alias they already define. A version
# the consumer already pins is theirs; the exception is detekt, which PRISM
# pins exactly because the rule set compiles against that precise detekt-api.
#
# These entries appear in no diff of the framework itself, which is why they
# are generated rather than remembered. Omit them and the install completes,
# reports success, and fails on the first `./gradlew staticAnalysis` with an
# unresolved dependency instead of a rule violation.

[versions]
agp = "9.1.0"
assertk = "0.28.1"
composeRules = "0.6.4"
coroutines = "1.10.2"
detekt = "2.0.0-alpha.6"
jacoco = "0.8.13"
junit5 = "5.11.3"
konsist = "0.17.3"
kotlin = "2.4.10"
ktlint = "1.8.0"

[libraries]
assertk-jvm = { group = "com.willowtreeapps.assertk", name = "assertk-jvm", version.ref = "assertk" }
compose-rules-detekt = { group = "io.nlopez.compose.rules", name = "detekt", version.ref = "composeRules" }
detekt-api = { group = "dev.detekt", name = "detekt-api", version.ref = "detekt" }
detekt-gradle-plugin = { group = "dev.detekt", name = "detekt-gradle-plugin", version.ref = "detekt" }
detekt-test = { group = "dev.detekt", name = "detekt-test", version.ref = "detekt" }
detekt-test-junit = { group = "dev.detekt", name = "detekt-test-junit", version.ref = "detekt" }
detekt-test-utils = { group = "dev.detekt", name = "detekt-test-utils", version.ref = "detekt" }
detekt-utils = { group = "dev.detekt", name = "detekt-utils", version.ref = "detekt" }
junit-jupiter = { group = "org.junit.jupiter", name = "junit-jupiter", version.ref = "junit5" }
junit-jupiter-engine = { group = "org.junit.jupiter", name = "junit-jupiter-engine", version.ref = "junit5" }
junit-platform-launcher = { group = "org.junit.platform", name = "junit-platform-launcher" }
konsist = { group = "com.lemonappdev", name = "konsist", version.ref = "konsist" }
kotlinx-coroutines-core = { group = "org.jetbrains.kotlinx", name = "kotlinx-coroutines-core", version.ref = "coroutines" }
ktlint-cli = { group = "com.pinterest.ktlint", name = "ktlint-cli", version.ref = "ktlint" }

[plugins]
kotlin-jvm = { id = "org.jetbrains.kotlin.jvm", version.ref = "kotlin" }
