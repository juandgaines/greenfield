root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
ktlint_experimental = enabled
max_line_length = 120
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 3
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 3
ktlint_standard_no-empty-first-line-in-class-body = disabled
ktlint_standard_no-blank-line-in-list = disabled
ktlint_standard_no-blank-lines-in-chained-method-calls = disabled

[*.kts]
ktlint_standard_filename = disabled

[**src/{test,androidTest}/**/*.kt]
max_line_length = 140
ktlint_ignore_back_ticked_identifier = true
